{
  "rewrites": [
    {
      "source": "/:date(\\d{4}-\\d{2}-\\d{2})",
      "destination": "/reports/:date/index.html"
    },
    {
      "source": "/:date(\\d{4}-\\d{2}-\\d{2})/",
      "destination": "/reports/:date/index.html"
    },
    {
      "source": "/:folder/:file",
      "destination": "/reports/:folder/:file.html"
    },
    {
      "source": "/:slug",
      "destination": "/reports/:slug/index.html"
    },
    {
      "source": "/:slug/",
      "destination": "/reports/:slug/index.html"
    }
  ]
}
